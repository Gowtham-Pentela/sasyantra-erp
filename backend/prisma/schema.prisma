// Sasyantra Manpower Ops ERP — slice schema
// Money is Decimal(18,2) in RUPEES (not paise). Decimal avoids float drift and
// handles large contract values that Int32 paise would overflow (~Rs 2.14cr ceiling).
// Coerced to JS number on output via one Express json replacer (main.ts).
// ponytail: no Client/Invoice/Payment/Expense tables this iteration — stubs only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPS
  ACCOUNTS
}

enum EmployeeStatus {
  ACTIVE
  LEFT
  TEMPORARY
  SUSPENDED
  BLACKLISTED
}

enum SalaryType {
  DAILY
  MONTHLY
}

enum AttendanceCode {
  P  // Present
  A  // Absent
  OT // Overtime
  HD // Half Day
  LV // Leave
  WO // Weekly Off
  HL // Holiday
  NS // Night Shift
  DS // Double Shift
  TR // Training
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ExpenseStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMode {
  BANK
  CASH
  UPI
  CHEQUE
}

enum BudgetEntryType {
  OPENING
  TOPUP
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  auditLogs    AuditLog[]
}

model Employee {
  id              Int              @id @default(autoincrement())
  empCode         String           @unique
  name            String
  fatherName      String?
  mobile          String?
  altMobile       String?
  address         String?
  dob             DateTime?
  gender          String?
  bloodGroup      String?
  emergencyContact String?
  aadhar          String?
  pan             String?
  bankAccount     String?
  ifsc            String?
  upi             String?
  joiningDate     DateTime         @default(now())
  skillCategory   String?
  designation     String?
  salaryType      SalaryType       @default(DAILY)
  dailyWage       Decimal          @default(0) @db.Decimal(18, 2)
  monthlySalary   Decimal          @default(0) @db.Decimal(18, 2)
  pf              Boolean          @default(false)
  esi             Boolean          @default(false)
  uan             String?
  photoUrl        String?
  status          EmployeeStatus   @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  archivedAt      DateTime?
  allocations     Allocation[]
  attendance      Attendance[]
  payroll         Payroll[]
  salaryPayments  SalaryPayment[]

  @@index([status])
}

model Project {
  id             Int            @id @default(autoincrement())
  code           String         @unique
  name           String
  clientName     String
  clientGst      String?
  siteLocation   String?
  mapsUrl        String?
  startDate      DateTime       @default(now())
  endDate        DateTime?
  billingCycle   String?
  paymentTerms   String?
  contractValue  Decimal        @default(0) @db.Decimal(18, 2)
  gstPercent     Decimal        @default(0) @db.Decimal(5, 2)
  status         ProjectStatus  @default(ACTIVE)
  projectManager String?
  createdAt      DateTime       @default(now())
  allocations    Allocation[]
  payroll        Payroll[]
  invoices       Invoice[]
  expenses       Expense[]

  @@index([status])
}

model Allocation {
  id            Int        @id @default(autoincrement())
  employeeId    Int
  projectId     Int
  role          String?
  dailyWage     Decimal    @default(0) @db.Decimal(18, 2)
  effectiveDate DateTime   @default(now())
  endDate       DateTime?
  remarks       String?
  createdAt     DateTime   @default(now())
  employee      Employee   @relation(fields: [employeeId], references: [id])
  project       Project    @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([employeeId])
}

model Attendance {
  id              Int             @id @default(autoincrement())
  employeeId      Int
  date            DateTime        @db.Date
  code            AttendanceCode  @default(P)
  otHours         Decimal         @default(0) @db.Decimal(6, 2)
  advance         Decimal         @default(0) @db.Decimal(18, 2)
  bonus           Decimal         @default(0) @db.Decimal(18, 2)
  travel          Decimal         @default(0) @db.Decimal(18, 2)
  food            Decimal         @default(0) @db.Decimal(18, 2)
  fine            Decimal         @default(0) @db.Decimal(18, 2)
  otherAllowance  Decimal         @default(0) @db.Decimal(18, 2)
  remarks         String?
  createdAt       DateTime        @default(now())
  employee        Employee        @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
}

model Payroll {
  id                   Int     @id @default(autoincrement())
  employeeId           Int
  projectId           Int?
  month                Int     // YYYYMM
  workingDays         Decimal @default(0) @db.Decimal(6, 2)
  presentDays          Decimal @default(0) @db.Decimal(6, 2)
  otHours             Decimal @default(0) @db.Decimal(6, 2)
  gross               Decimal @default(0) @db.Decimal(18, 2)
  attendanceDeduction Decimal @default(0) @db.Decimal(18, 2)
  basic               Decimal @default(0) @db.Decimal(18, 2)
  otAmount            Decimal @default(0) @db.Decimal(18, 2)
  bonus               Decimal @default(0) @db.Decimal(18, 2)
  advanceRecovery     Decimal @default(0) @db.Decimal(18, 2)
  travel              Decimal @default(0) @db.Decimal(18, 2)
  food                Decimal @default(0) @db.Decimal(18, 2)
  pf                  Decimal @default(0) @db.Decimal(18, 2)
  esi                 Decimal @default(0) @db.Decimal(18, 2)
  professionalTax     Decimal @default(0) @db.Decimal(18, 2)
  net                 Decimal @default(0) @db.Decimal(18, 2)
  employerCost        Decimal @default(0) @db.Decimal(18, 2)
  paid                Boolean  @default(false)
  paidDate            DateTime?
  generatedAt         DateTime @default(now())
  employee            Employee @relation(fields: [employeeId], references: [id])
  project             Project? @relation(fields: [projectId], references: [id])
  salaryPayment       SalaryPayment?

  @@unique([employeeId, month])
  @@index([month])
  @@index([projectId])
}

// --- Finance models (company cash fund) ---

// Opening balance + top-ups. Money in/out flows through the other tables.
model BudgetEntry {
  id        Int             @id @default(autoincrement())
  amount    Decimal         @db.Decimal(18, 2)
  type      BudgetEntryType @default(OPENING)
  date      DateTime        @default(now())
  note      String?
  createdAt DateTime        @default(now())
}

model Invoice {
  id         Int      @id @default(autoincrement())
  number     String   @unique // INV-####
  projectId  Int?
  issueDate  DateTime @default(now())
  dueDate    DateTime?
  subtotal   Decimal  @default(0) @db.Decimal(18, 2)
  gstPercent Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount  Decimal  @default(0) @db.Decimal(18, 2)
  total      Decimal  @default(0) @db.Decimal(18, 2)
  notes      String?
  createdAt  DateTime @default(now())
  project    Project? @relation(fields: [projectId], references: [id])
  payments   InvoicePayment[]

  @@index([projectId])
  @@index([issueDate])
}

model InvoicePayment {
  id           Int         @id @default(autoincrement())
  invoiceId    Int
  amount       Decimal     @db.Decimal(18, 2)
  receivedDate DateTime    @default(now())
  utr          String?
  mode         PaymentMode @default(BANK)
  remarks      String?
  createdAt    DateTime    @default(now())
  invoice      Invoice     @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([receivedDate])
}

model Expense {
  id         Int           @id @default(autoincrement())
  date       DateTime       @default(now())
  category   String
  vendor      String?
  amount      Decimal       @default(0) @db.Decimal(18, 2)
  gst         Decimal       @default(0) @db.Decimal(18, 2)
  projectId   Int?
  paidAmount  Decimal       @default(0) @db.Decimal(18, 2)
  status      ExpenseStatus @default(UNPAID)
  dueDate     DateTime?
  paidDate    DateTime?
  remarks     String?
  createdAt   DateTime       @default(now())
  project     Project?      @relation(fields: [projectId], references: [id])

  @@index([date])
  @@index([projectId])
  @@index([status])
}

// one per payroll row (payrollId @unique). Reduces the cash fund when created.
model SalaryPayment {
  id         Int         @id @default(autoincrement())
  payrollId  Int         @unique
  employeeId Int
  month      Int
  amount     Decimal     @db.Decimal(18, 2)
  paidDate   DateTime    @default(now())
  utr        String?
  mode       PaymentMode @default(BANK)
  remarks    String?
  createdAt  DateTime    @default(now())
  payroll    Payroll     @relation(fields: [payrollId], references: [id])
  employee   Employee    @relation(fields: [employeeId], references: [id])

  @@index([month])
  @@index([employeeId])
}

// Immutable audit trail. Never cascade-delete history when a record is archived.
model AuditLog {
  id        Int        @id @default(autoincrement())
  userId    Int?
  userName  String?
  module    String
  action    AuditAction
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime   @default(now())
  user      User?       @relation(fields: [userId], references: [id])

  @@index([module])
  @@index([entity, entityId])
  @@index([createdAt])
}